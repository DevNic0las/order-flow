# Copie este arquivo para .env e preencha os valores antes de rodar
# docker compose up -d
#
#   cp .env.example .env
#
# O docker-compose.yml lê essas variáveis automaticamente a partir do
# arquivo .env na raiz do projeto — não é preciso exportar manualmente.

# ── Autenticação (obrigatório) ──────────────────────────────────────
# Chave secreta usada para assinar e validar os JWTs (gateway,
# auth-service, order, inventory). Sem isso definido, os serviços
# sobem com um secret vazio e falham no primeiro request autenticado.
# Gere uma string aleatória longa, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=

# ── Envio de e-mail via Brevo (opcional em dev) ─────────────────────
# Sem preencher, o notification-service ainda sobe normalmente, mas o
# envio de e-mail real falha silenciosamente (verifique os logs).
# Para desenvolvimento local, os e-mails de teste podem ser
# inspecionados no Mailpit (http://localhost:8025) sem precisar
# dessas variáveis.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@orderflow.com
BREVO_SENDER_NAME=orderflow
BREVO_API_URL=https://api.brevo.com
